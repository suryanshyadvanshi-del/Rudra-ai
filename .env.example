# Add these in Netlify: Site configuration > Environment variables.
# Never put secret values in public/ files or commit a real .env file.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face token with permission to use Inference Providers
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Optional: restrict requests to your deployed site origin, e.g.
# ALLOWED_ORIGIN=https://your-site.netlify.app